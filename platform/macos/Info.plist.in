<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>@CTR_APP_NAME@</string>
	<key>CFBundleExecutable</key>
	<string>ctr_native</string>
	<key>CFBundleIconFile</key>
	<string>PowerSlide</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.madop67.powerslide</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>@CTR_APP_NAME@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@CTR_APP_SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@CTR_APP_SHORT_VERSION@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.racing-games</string>
	<key>LSMinimumSystemVersion</key>
	<string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>@CTR_APP_NAME@ is free software under the GNU GPL v3. Crash Team Racing is a trademark of its owners; no game data is included.</string>
</dict>
</plist>
